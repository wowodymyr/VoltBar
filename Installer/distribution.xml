<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>VoltBar</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="x86_64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.voltbar.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.voltbar.pkg" visible="false">
        <pkg-ref id="com.voltbar.pkg"/>
    </choice>
    <pkg-ref id="com.voltbar.pkg" version="__VERSION__" onConclusion="none">VoltBar-component.pkg</pkg-ref>
</installer-gui-script>
